# .gitignore for ESP32 Battery Monitor Project

# ============ PlatformIO ============
.pioenvs/
.piolibdeps/
*.pio
*.pio~
.piobuild/

# ============ Build Artifacts ============
build/
dist/
*.o
*.d
*.obj
*.a
*.so
*.dll
*.exe
*.bin
*.elf
*.map
partitions.csv

# ============ IDE Files ============
.idea/
.vscode/settings.json
.vscode/tasks.json
.vscode/c_cpp_properties.json
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ============ Logs (Application Only) ============
logs/*.log
serial_log.txt
flash_log.txt

# ============ Test Coverage ============
gcov/
coverage/
*.gcno
*.gcda
# Keep test output logs though
!tests/*.log

# ============ Temporary Files ============
tmp/
temp/
*.tmp
*.bak

# ============ Configuration ============
# Ignore personal board profiles, keep examples
!config/*.example
config/board_profile.h
config/local_config.h

# ============ Hardware Documentation ============
# Ignore large CAD binaries, keep PDFs (datasheets, specs)
docs/hardware/*.step
docs/hardware/*.stl
docs/hardware/*.stp
# Ignore generated renderings
docs/hardware/renderings/

# ============ Python Cache ============
__pycache__/
*.py[cod]
*$py.class
.Python
pip-log.txt
pip-delete-this-directory.txt

# ============ CMake (Auto-generated only) ============
CMakeFiles/
cmake_install.cmake
build/Makefile

# ============ Compiler Specific ============
*.orig
*.rej

# ============ Miscellaneous ============
*.csv

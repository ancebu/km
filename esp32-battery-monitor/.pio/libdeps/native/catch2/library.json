{
  "name": "catch2",
  "version": "3.7.1",
  "description": "A modern, C++-native, test framework for unit-tests, TDD and BDD - using C++14, C++17 and later (C++11 support is in v2.x branch, and C++03 on the Catch1.x branch) ",
  "repository": {
    "type": "git",
    "url": "https://github.com/baracodadailyhealthtech/platformio_catch2"
  },
  "license": "BSL-1.0",
  "platforms": "native",
  "frameworks": "*",
  "build": {
    "includeDir": "src",
    "flags": [
        "-Ithird_party",
        "-DBUILD_TESTING=OFF",
        "-DCATCH_INSTALL_DOCS=OFF"
